#!/usr/bin/env bash
set -euo pipefail

# Build the distributed MCP engine from the installed sources when needed.
# The compiled engine is platform-specific and deliberately not committed.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENGINE="$ROOT/engine/dist/finstack"

# Match the skill preambles when a host provides a writable plugin data root.
# Native Codex MCP manifests do not interpolate environment placeholders.
if [ -n "${PLUGIN_DATA:-}" ]; then
  export FINSTACK_HOME="$PLUGIN_DATA"
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "finstack requires Bun 1.3.14+ to build its local engine. Install Bun, then retry." >&2
  exit 1
fi

if [ ! -x "$ENGINE" ] || find "$ROOT/engine/src" "$ROOT/package.json" -type f -newer "$ENGINE" -print -quit | grep -q .; then
  mkdir -p "$(dirname "$ENGINE")"
  bun build --compile "$ROOT/engine/src/cli.ts" --outfile "$ENGINE" >&2
fi

exec "$ENGINE" "$@"
