#!/usr/bin/env bash
set -euo pipefail

# finstack — prepare the data directory.
#
# You do not normally need to run this. Installing the plugin is enough: the
# engine builds itself on first use, and the directories below are created on
# demand.
#
# Run it when you want the git history set up before your first session, or
# when working from a clone rather than an installed plugin.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DATA="${FINSTACK_HOME:-$HOME/.finstack}"

echo "finstack — An Operating System for Investment Thinking"
echo ""

# ── Data directory ──
echo "Setting up $DATA"
mkdir -p "$DATA"/{journal,patterns,cache,reports,sessions,bin}

# Your decision history is versioned so `git log` is an audit trail and
# `git diff` shows how your thinking changed. No remote is ever added —
# see SECURITY.md before adding one.
if [ ! -d "$DATA/.git" ]; then
  (cd "$DATA" && git init -q && git commit --allow-empty -q -m "init: finstack cognitive memory")
  echo "  ✓ git initialized"
else
  echo "  ✓ already initialized"
fi

# ── Engine ──
# The skill preamble builds this on first use, so this is only a convenience
# for people who would rather not wait during their first question.
if command -v bun >/dev/null 2>&1; then
  echo "Building the engine..."
  (cd "$SCRIPT_DIR" && bun install --frozen-lockfile >/dev/null 2>&1 || bun install >/dev/null 2>&1
   bun build --compile engine/src/cli.ts --outfile "$DATA/bin/finstack" >/dev/null 2>&1)
  echo "  ✓ $DATA/bin/finstack"
else
  echo "  - bun not found; the engine will install it and build on first use"
fi

# ── Git hooks, for contributors ──
if [ -d "$SCRIPT_DIR/.git" ]; then
  "$SCRIPT_DIR/bin/finstack-install-hooks"
fi

cat <<EOF

Done.

Install the plugin so Codex can find the skills:

  codex plugin marketplace add kohoj/finstack
  codex plugin add finstack@finstack

Then just ask — the skills are model-invoked, so there are no commands to
memorize:

  "check my portfolio for concentration risk"
  "should I buy NVDA?"
  "what does a TSMC capex cut mean for my holdings?"

Data directory: $DATA
EOF
