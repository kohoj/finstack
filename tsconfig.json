{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./engine/dist",
    "rootDir": ".",
    "types": ["bun"]
  },
  "include": ["engine/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
